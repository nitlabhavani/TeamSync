PORT=5000
NODE_ENV=development

APP_NAME=TeamSync AI

CLIENT_ORIGIN=http://localhost:8080
CLIENT_URL=http://localhost:8080

MONGO_URI=mongodb://127.0.0.1:27017/teamsync_ai

JWT_SECRET=replace-with-a-secure-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

REFRESH_TOKEN_SECRET=replace-with-another-secure-random-secret-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

EMAIL_PROVIDER=brevo-smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
MAIL_FROM_NAME=TeamSync AI
MAIL_FROM_EMAIL=no-reply@example.com

OTP_TTL_MINUTES=5
EXPOSE_DEV_OTP=false

INVITE_OTP_TTL_MINUTES=5
INVITE_OTP_MAX_ATTEMPTS=5
INVITE_OTP_MAX_RESENDS=5
INVITE_OTP_LOCK_MINUTES=15

OTP_RESEND_COOLDOWN_MS=30000

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
MAX_VOICE_MB=15

AI_ENGINE_URL=http://127.0.0.1:8000
AI_ENGINE_KEY=
AI_ENGINE_TIMEOUT_MS=20000
